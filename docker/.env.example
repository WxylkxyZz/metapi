# Canopy 部署配置样例 —— 复制为 .env 后填写
# cp docker/.env.example docker/.env
# 完整环境变量清单见 docs/DEPLOYMENT.md

# ---- 必填：管理后台 / 下游访问令牌（务必改成强随机值）----
AUTH_TOKEN=change-me-admin-token
PROXY_TOKEN=change-me-proxy-token

# ---- 推荐：加密上游账号凭据的主密钥（强随机长串）----
# ACCOUNT_CREDENTIAL_SECRET=

# ---- 可选：常用项 ----
PORT=4000
# TZ=Asia/Shanghai
NOTIFY_COOLDOWN_SEC=300
ADMIN_IP_ALLOWLIST=
# 反代源 IP/CIDR 白名单（逗号分隔）。仅在有反向代理时填写，否则会信任伪造的 X-Forwarded-For。
TRUSTED_PROXY=

# ---- 定时任务（默认即可）----
CHECKIN_CRON=0 8 * * *
BALANCE_REFRESH_CRON=0 * * * *

# ---- 构建期代理（可选）----
# 仅用于 Docker 构建时拉取 apt/npm 依赖，不会烧入镜像。
# Docker Desktop 上可用 http://host.docker.internal:PORT 访问宿主代理。
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890