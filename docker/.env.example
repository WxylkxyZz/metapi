# Meta API Hub - Environment Variables
# Copy this file to .env and fill in your values
# cp .env.example .env

# Admin authentication token (required, change this!)
AUTH_TOKEN=123456

# Proxy API token used for OpenAI-compatible proxy endpoint (required, change this!)
PROXY_TOKEN=sk-change-me
PORT=4000
NOTIFY_COOLDOWN_SEC=300
ADMIN_IP_ALLOWLIST=
# Reverse-proxy source IP(s)/CIDR(s) whose X-Forwarded-For may be trusted (comma-separated).
# Leave empty to ignore X-Forwarded-For entirely and use the real socket IP.
TRUSTED_PROXY=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Auto check-in cron (default: 8:00 AM every day)
CHECKIN_CRON=0 8 * * *

# Balance refresh cron (default: every hour)
BALANCE_REFRESH_CRON=0 * * * *

# Build-time proxy (optional). Used by the Docker build to fetch apt/npm deps.
# On Docker Desktop, reach the host's proxy via http://host.docker.internal:PORT.
# Leave empty to build without a proxy. Not baked into the image at runtime.
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
